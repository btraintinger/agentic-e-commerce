#!/bin/sh
set -eu

# The amend below runs this hook again. Only update the report once.
if [ "${TIME_TRACKING_UPDATE_IN_PROGRESS:-}" = "1" ]; then
    exit 0
fi

report_file=$(mktemp "${TMPDIR:-/tmp}/time-report.XXXXXX")
trap 'rm -f "$report_file"' 0
trap 'exit 1' HUP INT TERM

# Use the completed history so amended times and commit authors are counted correctly.
sh scripts/time-report.sh > "$report_file"
cat "$report_file" > TIME_TRACKING.md
git add -- TIME_TRACKING.md

if git diff --cached --quiet HEAD -- TIME_TRACKING.md; then
    exit 0
fi

# Restrict the amend to the report, preserving unrelated staged changes.
if ! TIME_TRACKING_UPDATE_IN_PROGRESS=1 git commit --amend --no-edit --only --quiet -- TIME_TRACKING.md; then
    echo "Time tracking could not be included automatically; the original commit still exists." >&2
    exit 1
fi
